{
  "collectionName": "components_blocks_medias",
  "info": {
    "displayName": "Media (photo or video)",
    "description": "A photo, a wide video or a vertical video, full width or beside text",
    "icon": "layout"
  },
  "options": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "enum": [
        "photo",
        "video",
        "vertical",
        "two"
      ],
      "default": "photo"
    },
    "layout": {
      "type": "enumeration",
      "enum": [
        "full",
        "beside"
      ],
      "default": "full"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "photoLabel": {
      "type": "string"
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "video": {
      "type": "component",
      "component": "parts.video",
      "repeatable": false
    },
    "caption": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "body": {
      "type": "text"
    },
    "mediaSide": {
      "type": "enumeration",
      "enum": [
        "right",
        "left"
      ],
      "default": "right"
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "cream",
        "light_blue"
      ],
      "default": "white"
    },
    "headingLevel": {
      "type": "integer",
      "default": 2
    }
  }
}
