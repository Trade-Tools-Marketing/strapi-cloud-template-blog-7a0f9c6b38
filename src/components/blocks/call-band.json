      "component": "shared.link",
      "repeatable": false
    },
    "consent": {
      "type": "string"
    },
    "sendLabel": {
      "type": "string"
    },
    "sendingLabel": {
      "type": "string"
    },
    "sentTitle": {
      "type": "string"
    },
    "sentMessage": {
      "type": "string"
    },
    "failedMessage": {
      "type": "string"
