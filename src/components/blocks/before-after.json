{
  "collectionName": "components_blocks_before_afters",
  "info": {
    "displayName": "Before / after",
    "description": "Headline, text, button and two photos side by side",
    "icon": "layout"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "text"
    },
    "showButton": {
      "type": "boolean",
      "default": true
    },
    "button": {
      "type": "component",
      "component": "shared.button",
      "repeatable": false
    },
    "beforeImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "beforeLabel": {
      "type": "string"
    },
    "beforeCaption": {
      "type": "string",
      "default": "Before"
    },
    "afterImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "afterLabel": {
      "type": "string"
    },
    "afterCaption": {
      "type": "string",
      "default": "After"
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "cream",
        "light_blue"
      ],
      "default": "white"
    },
    "headingLevel": {
      "type": "integer",
      "default": 2
    }
  }
}
