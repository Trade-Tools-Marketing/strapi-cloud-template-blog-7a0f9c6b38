{
  "collectionName": "components_blocks_stepss",
  "info": {
    "displayName": "Steps",
    "description": "Numbered steps, in a row or as a timeline beside a photo",
    "icon": "layout"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "steps": {
      "type": "component",
      "component": "parts.step",
      "repeatable": true
    },
    "layout": {
      "type": "enumeration",
      "enum": [
        "auto",
        "horizontal",
        "vertical"
      ],
      "default": "auto"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "photoLabel": {
      "type": "string"
    },
    "button": {
      "type": "component",
      "component": "shared.button",
      "repeatable": false
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "cream",
        "light_blue"
      ],
      "default": "white"
    },
    "headingLevel": {
      "type": "integer",
      "default": 2
    }
  }
}
