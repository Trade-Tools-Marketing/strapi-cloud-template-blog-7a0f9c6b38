{
  "collectionName": "components_blocks_plan_compares",
  "info": {
    "displayName": "Plan comparison",
    "description": "Compares 2–3 plans with the \"Most popular\" tab",
    "icon": "layout"
  },
  "options": {},
  "attributes": {
    "anchorId": {
      "type": "string"
    },
    "heading": {
      "type": "string",
      "required": true
    },
    "intro": {
      "type": "text"
    },
    "plans": {
      "type": "component",
      "component": "parts.compare-plan",
      "repeatable": true
    },
    "features": {
      "type": "component",
      "component": "parts.table-row",
      "repeatable": true
    },
    "common": {
      "type": "component",
      "component": "shared.text-item",
      "repeatable": true
    },
    "popularLabel": {
      "type": "string",
      "default": "Most popular"
    },
    "joinLabel": {
      "type": "string",
      "default": "Join the plan"
    },
    "tableHeading": {
      "type": "string",
      "default": "Compare all features"
    },
    "compareLabel": {
      "type": "string",
      "default": "Compare all {n} plans"
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "cream"
      ],
      "default": "white"
    },
    "headingLevel": {
      "type": "integer",
      "default": 2
    }
